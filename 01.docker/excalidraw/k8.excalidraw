      "seed": 1405985421,
      "version": 179,
      "versionNonce": 81173197,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779054947961,
      "link": null,
      "locked": false,
      "text": "Each pods get it's own ip\naddress not the container \nbut the pod , each pod gets its\nown ip address given to them by \nk8 virtual network ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each pods get it's own ip\naddress not the container \nbut the pod , each pod gets its\nown ip address given to them by \nk8 virtual network ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
