      "updated": 1779046480433,
      "link": null,
      "locked": false,
      "text": "Official Defination of Kubernetes\n->Open source container orchestration tool\n->Developed by google\n->Helps manage containerized application\nin different deployment environments(Bare metal,vm or cloud)",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Official Defination of Kubernetes\n->Open source container orchestration tool\n->Developed by google\n->Helps manage containerized application\nin different deployment environments(Bare metal,vm or cloud)",
      "autoResize": true,
      "lineHeight": 1.25
    },
