    {
      "id": "oSRKIs2Cadh83Qh7gZTZ7",
      "type": "text",
      "x": 1268.4061568231814,
      "y": 9878.056437388768,
      "width": 352,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZ",
