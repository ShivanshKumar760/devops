      "text": "This is containerization\nit helps u take a sanpshot\nof the api /application \nand run it in a very \nlightweight linux env \n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is containerization\nit helps u take a sanpshot\nof the api /application \nand run it in a very \nlightweight linux env \n",
      "autoResize": true,
