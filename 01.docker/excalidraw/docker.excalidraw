    {
      "id": "9648JV9VNUKYqYzxPKtfP",
      "type": "text",
      "x": 617.1546191320208,
      "y": 752.4102409811222,
      "width": 825,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 145016117,
      "version": 1569,
      "versionNonce": 2066364507,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777640120991,
      "link": null,
      "locked": false,
      "text": "->Another important point is many times we work with a perticular\nversion of programming language and its package manager , like \ni can be using nodejs v20 and npm v8.0 or i can be using java v18\nand maven v4 or i can be using python v3.9 and pip v20 and someone \non the other computer maybe using different version of programming \nlanguage and package manager cause of which setting up development \nenvironment for a common project in which two or more people are working \nbecomes difficult , we would to be in sync with the version of programming \nlanguage and package manager to solve this issue of \"its running on my \nmachine i dont why its not running on your machine \" we use docker \ndocker create a image which is basically bundle file of \nour project with desired programming language version , database version\nand package version with our application and a very light copy of  a\nlinux engine which then docker loads into a container and run our app\n\n\n->so tomorrow if someone has to run or deploy our app they just have \nto have a docker install and then they can pull image from docker hub\nor we can share the dockerfile ,via which they can build image and \nrun it in a container ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "->Another important point is many times we work with a perticular\nversion of programming language and its package manager , like \ni can be using nodejs v20 and npm v8.0 or i can be using java v18\nand maven v4 or i can be using python v3.9 and pip v20 and someone \non the other computer maybe using different version of programming \nlanguage and package manager cause of which setting up development \nenvironment for a common project in which two or more people are working \nbecomes difficult , we would to be in sync with the version of programming \nlanguage and package manager to solve this issue of \"its running on my \nmachine i dont why its not running on your machine \" we use docker \ndocker create a image which is basically bundle file of \nour project with desired programming language version , database version\nand package version with our application and a very light copy of  a\nlinux engine which then docker loads into a container and run our app\n\n\n->so tomorrow if someone has to run or deploy our app they just have \nto have a docker install and then they can pull image from docker hub\nor we can share the dockerfile ,via which they can build image and \nrun it in a container ",
      "autoResize": true,
      "lineHeight": 1.25
    },
