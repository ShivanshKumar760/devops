    },
    {
      "id": "POAT0UEZo8YLMg0owx43s",
      "type": "text",
      "x": 375.09631843323456,
      "y": 2201.7196293923503,
      "width": 781,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 512231765,
      "version": 195,
      "versionNonce": 1997221755,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777641563987,
      "link": null,
      "locked": false,
      "text": "Docker has 3 parts\n1.CLI(Command Line interface) every docker command starts with \"docker\"\n2.Docker engine(sock) \n3.Docker registry(Docker hub) where we push our images ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Docker has 3 parts\n1.CLI(Command Line interface) every docker command starts with \"docker\"\n2.Docker engine(sock) \n3.Docker registry(Docker hub) where we push our images ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
