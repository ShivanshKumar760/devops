    {
      "id": "CVey_MQUnIKAuz6d5w9aA",
      "type": "text",
      "x": 447.02631173472764,
      "y": 8618.900668501059,
      "width": 785.399658203125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
      "roundness": null,
      "seed": 1202519765,
      "version": 58,
      "versionNonce": 1226875035,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777645484751,
      "link": null,
      "locked": false,
      "text": "To use the Docker REST API in your backend, the\nmost common and efficient way is to use an official\nDocker SDK rather than making raw HTTP calls. The\nSDKs handle low-level details like Unix socket\ncommunication and JSON parsing for you.",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To use the Docker REST API in your backend, the most common and efficient way is to use an official Docker SDK rather than making raw HTTP calls. The SDKs handle low-level details like Unix socket communication and JSON parsing for you.",
      "autoResize": false,
      "lineHeight": 1.25
    },
